<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="22dp">

    <!-- Full height stripe on the left -->
    <View
        android:id="@+id/header_stripe"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <!-- Server name + status indicator centered vertically -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/header_server_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:gravity="center_vertical"
            android:textColor="?colorOnSurfaceVariant"
            android:textStyle="normal" />

        <View
            android:id="@+id/header_server_status"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/online_indicator" />

    </LinearLayout>

</FrameLayout>
